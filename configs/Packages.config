### OpenWrt SDK软件包编译配置项 ###

CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_LUCI_LANG_zh_Hant=y

CONFIG_PACKAGE_frpc=n
CONFIG_PACKAGE_frps=n
CONFIG_PACKAGE_gecoosac=n
CONFIG_PACKAGE_nginx-full=n
CONFIG_PACKAGE_openlist2=n
CONFIG_PACKAGE_luci-app-aria2=n
CONFIG_PACKAGE_luci-app-frpc=n
CONFIG_PACKAGE_luci-app-frps=n
CONFIG_PACKAGE_luci-app-gecoosac=n
CONFIG_PACKAGE_luci-app-aurora-config=n
CONFIG_PACKAGE_luci-app-openlist2=n
CONFIG_PACKAGE_luci-theme-aurora=n

### Aria2配置项 ###

CONFIG_PACKAGE_aria2=n
CONFIG_PACKAGE_ariang=n

CONFIG_ARIA2_OPENSSL=n
# CONFIG_ARIA2_GNUTLS is not set
# CONFIG_ARIA2_NOSSL is not set
# CONFIG_ARIA2_LIBXML2 is not set
CONFIG_ARIA2_EXPAT=n
# CONFIG_ARIA2_NOXML is not set
CONFIG_ARIA2_BITTORRENT=n
CONFIG_ARIA2_METALINK=n
CONFIG_ARIA2_SFTP=y
CONFIG_ARIA2_ASYNC_DNS=y
# CONFIG_ARIA2_COOKIE is not set
CONFIG_ARIA2_WEBSOCKET=y
