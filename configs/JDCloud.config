CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02="luci-app-athena-led luci-i18n-athena-led-zh-cn"

CONFIG_ATH11K_MEM_PROFILE_512M=y
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
CONFIG_PACKAGE_luci-app-athena-led=m
CONFIG_PACKAGE_luci-i18n-athena-led-zh-cn=m

CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_logrotate=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-app-mount-points=y
CONFIG_PACKAGE_ntfs-3g=y


### EC25 / Quectel 蜂窝模块驱动（QMI 模式，EC25/EG25-G 默认）
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-wdm=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_umbim=y
CONFIG_PACKAGE_luci-proto-qmi=y
CONFIG_PACKAGE_luci-proto-mbim=y

### DJOneHub & VOHive 前端（核心在运行时从自托管 release 仓库拉取，保留 v1.4.3）
CONFIG_PACKAGE_luci-app-djonehub=y
CONFIG_PACKAGE_luci-app-vohive=y

### re-ss-01 设备包清单（确保上述驱动与插件进入该机型 rootfs）
### 注意：DEVICE_PACKAGES 变量名必须用 SUBTARGET，即 ipq60xx（见 .config 中 CONFIG_TARGET_SUBTARGET="ipq60xx"）
CONFIG_TARGET_DEVICE_PACKAGES_ipq60xx_DEVICE_jdcloud_re-ss-01="kmod-usb-serial kmod-usb-serial-option kmod-usb-net kmod-usb-wdm kmod-usb-net-qmi-wwan kmod-usb-net-cdc-ether kmod-usb-net-cdc-ncm uqmi umbim luci-proto-qmi luci-proto-mbim luci-app-djonehub luci-app-vohive"

### WLOC 虚拟定位：strongSwan IKEv2 服务端（让 iPhone 经原生 VPN + 用户 CA 信任 locationd，实现 WLOC 坐标改写）
### 重要：strongswan 只是 libstrongswan 基础库，不含 daemon！
###       IKEv2 守护进程 charon 与配置工具 swanctl 是独立包，必须显式勾选，
###       否则编译出来的固件只有 .so 而没有可执行文件（swanctl: not found）。
###       strongswan-default 元包依赖已含 charon + swanctl + 常用 plugin 全套（pubkey/x509/pem/aes/sha2/socket-default 等）。
CONFIG_PACKAGE_strongswan=y
CONFIG_PACKAGE_strongswan-default=y
CONFIG_PACKAGE_strongswan-charon=y
CONFIG_PACKAGE_strongswan-swanctl=y
CONFIG_PACKAGE_strongswan-mod-kernel-netlink=y
CONFIG_PACKAGE_strongswan-mod-vici=y
CONFIG_PACKAGE_strongswan-mod-eap-mschapv2=y
CONFIG_PACKAGE_strongswan-mod-eap-identity=y
CONFIG_PACKAGE_strongswan-mod-resolve=y
CONFIG_PACKAGE_strongswan-mod-openssl=y
### aes256gcm16 ESP 提案需要 gcm plugin（strongswan-default 不含，必须显式勾）
CONFIG_PACKAGE_strongswan-mod-gcm=y


