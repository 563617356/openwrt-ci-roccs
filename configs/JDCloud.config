CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02="luci-app-athena-led luci-i18n-athena-led-zh-cn"

CONFIG_ATH11K_MEM_PROFILE_512M=y
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
CONFIG_PACKAGE_luci-app-athena-led=m
CONFIG_PACKAGE_luci-i18n-athena-led-zh-cn=m

CONFIG_PACKAGE_luci-app-openclash=y

# 禁用不需要的包
# CONFIG_PACKAGE_nginx-full is not set
# CONFIG_PACKAGE_logrotate is not set
# CONFIG_PACKAGE_luci-app-openlist2 is not set

# Aria2 配置項 - 全部禁用
# CONFIG_PACKAGE_ariang is not set
# CONFIG_PACKAGE_luci-app-aria2 is not set
# CONFIG_ARIA2_OPENSSL is not set
# CONFIG_ARIA2_GNUTLS is not set
# CONFIG_ARIA2_NOSSL is not set
# CONFIG_ARIA2_LIBXML2 is not set
# CONFIG_ARIA2_EXPAT is not set
# CONFIG_ARIA2_NOXML is not set
# CONFIG_ARIA2_BITTORRENT is not set
# CONFIG_ARIA2_METALINK is not set

# ========== 核心無線加密組件（必須選，解決連不上、不分配IP） ==========
CONFIG_PACKAGE_wpad-openssl=y
# 如果提示衝突，可以換成下面這行（二選一，通常 wpad-openssl 更適合高通）
# CONFIG_PACKAGE_wpad-mesh-openssl=y

# ========== 高通 IPQ60xx / NSS 無線驅動與固件 ==========
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_kmod-ath11k-pci=y
CONFIG_PACKAGE_ath11k-firmware-ipq60xx=y

# ========== 核心網路與 DHCP 基礎組件 ==========
CONFIG_PACKAGE_dnsmasq-full=y
# 注意：選了 dnsmasq-full 請確保禁用了基礎版，防止衝突：
# CONFIG_PACKAGE_dnsmasq is not set

# ========== 雅典娜/亞瑟 LED 燈光控制（你配置裡選成了 =m 導致沒編譯進固件，改成 =y） ==========
CONFIG_PACKAGE_luci-app-athena-led=y
CONFIG_PACKAGE_luci-i18n-athena-led-zh-cn=y

# CONFIG_ARIA2_SFTP is not set
# CONFIG_ARIA2_ASYNC_DNS is not set
# CONFIG_ARIA2_COOKIE is not set
# CONFIG_ARIA2_WEBSOCKET is not set
