CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02="luci-app-athena-led luci-i18n-athena-led-zh-cn"

CONFIG_ATH11K_MEM_PROFILE_512M=y
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
CONFIG_PACKAGE_luci-app-athena-led=m
CONFIG_PACKAGE_luci-i18n-athena-led-zh-cn=m

CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_logrotate=y

### EC25 / Quectel 蜂窝模块驱动（QMI 模式，EC25/EG25-G 默认）
CONFIG_PACKAGE_kmod-usb-serial=m
CONFIG_PACKAGE_kmod-usb-serial-option=m
CONFIG_PACKAGE_kmod-usb-net=m
CONFIG_PACKAGE_kmod-usb-wdm=m
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=m
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=m
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=m
CONFIG_PACKAGE_uqmi=m
CONFIG_PACKAGE_umbim=m
CONFIG_PACKAGE_luci-proto-qmi=m
CONFIG_PACKAGE_luci-proto-mbim=m

### DJOneHub & VOHive 前端（核心在运行时从自托管 release 仓库拉取，保留 v1.4.3）
CONFIG_PACKAGE_luci-app-djonehub=m
CONFIG_PACKAGE_luci-app-vohive=m

### re-ss-01 设备包清单（确保上述驱动与插件进入该机型 rootfs）
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01="kmod-usb-serial kmod-usb-serial-option kmod-usb-net kmod-usb-wdm kmod-usb-net-qmi-wwan kmod-usb-net-cdc-ether kmod-usb-net-cdc-ncm uqmi umbim luci-proto-qmi luci-proto-mbim luci-app-djonehub luci-app-vohive"


